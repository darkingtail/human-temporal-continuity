.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end
.gstack/

# Python Silent Core local state.
core/.venv/
core/.pytest_cache/
core/.ruff_cache/
core/.tmp-test/
core/pytest-tmp*/
