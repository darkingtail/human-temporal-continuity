{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htc.local/contracts/observation.schema.json",
  "title": "HTC Observation Request",
  "type": "object",
  "required": ["request", "proposal"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["user_id", "conversation_id", "turn_id", "observed_at", "timezone"],
      "properties": {
        "user_id": {"type": "string", "minLength": 1},
        "conversation_id": {"type": "string", "minLength": 1},
        "turn_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1},
        "role": {"type": "string"},
        "text": {"type": "string", "maxLength": 500}
      },
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "required": ["kind", "summary", "speech_act"],
      "properties": {
        "kind": {"enum": ["Episode", "State", "Intention", "Meaning"]},
        "summary": {"type": "string", "minLength": 1},
        "speech_act": {"enum": ["actual", "test", "quoted", "hypothetical", "roleplay", "uncertain"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sensitivity": {"enum": ["normal", "personal", "sensitive", "forbidden"]},
        "time": {"type": "object"},
        "permissions": {"type": "object"},
        "attributes": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
